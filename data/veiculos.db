class CarroModel:
    def __init__(self, marca: str, modelo: str, ano: int, portas: int):
        self.marca = marca
        self.modelo = modelo
        self.ano = ano
        self.portas = portas

    @staticmethod
    def obter_todos():
        """Simula a busca de carros em um banco de dados."""
        return [
            CarroModel("Toyota", "Corolla", 2023, 4),
            CarroModel("Honda", "Civic", 2022, 4),
            CarroModel("Fiat", "Uno", 2015, 2)
        ]